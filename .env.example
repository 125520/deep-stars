# ══════════════════════════════════════════════════════════════
#  Deep Stars · 深星  ——  环境变量示例
#  复制为 .env.local 后按需填写。全部留空也能跑：数据库默认
#  用本地 SQLite，AI 能力自动降级为内置规则引擎。
# ══════════════════════════════════════════════════════════════

# ── 数据库 ───────────────────────────────────────────────
# 本地开发（零依赖，开箱即用）
DATABASE_URL="file:./dev.db"
# 线上（Vercel + Neon）示例：
# DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# ── 认证 ─────────────────────────────────────────────────
# 生成：openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3210"

# ── 加密 ────────────────────────────────────────────────
# BYOK：用户自带的 AI Key 用它对称加密后落库。
# 生成：openssl rand -hex 32
# ⚠️ 一旦设置就不要更换 —— 换了之后所有已保存的密钥都解不开（会静默降级为「未配置」）。
DEEP_STARS_SECRET=""

# ── 管理后台 ─────────────────────────────────────────────
# 引导管理员邮箱。全新部署时数据库里没有任何管理员，
# 而「第一个管理员」没法由后台自己产生，只能在这里指定。
# 之后可以在后台里给别人授权，这个变量就不再需要了。
DEEP_STARS_ADMIN_EMAIL=""

# ── AI（留空 = 本地规则引擎降级，功能仍完整可用）──────────
AGNES_API_KEY=""
AGNES_BASE_URL="https://api.agnes-ai.cn/v1"
DASHSCOPE_MODEL="agnes-2.5-flash"

# 向量模型（知识库检索用）
EMBEDDING_API_KEY=""
EMBEDDING_BASE_URL=""
EMBEDDING_MODEL=""

# 每用户每日 token 上限（0 = 不限）
AI_TOKEN_LIMIT="1000000"
# 全站每日 token 总上限（公网部署防滥用，0 = 不限）
AI_GLOBAL_DAILY_LIMIT="20000000"

# ── 站点 ─────────────────────────────────────────────────
#
# 站点自身的地址。**代码里已经没有任何地方读 NEXT_PUBLIC_SITE_URL** ——
# 曾经打算用它做 OG 元数据，后来没接上。留着只会让人以为它有用、
# 部署时白白多填一项，所以删掉。
#
# 线上**不需要**填 BETTER_AUTH_URL：应用会退回平台注入的
# RENDER_EXTERNAL_HOSTNAME 并自动补协议头（见 src/lib/site-url.ts），
# 于是不必"部署完回填地址再重新部署一次"。
# 只有绑定自定义域名时才需要显式设置 BETTER_AUTH_URL。
