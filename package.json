{
  "name": "deep-stars",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "description": "Deep Stars · 深星 —— 深夜星图风格的学习成长平台",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-schema.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch --test-isolation=none \"tests/**/*.test.ts\"",
    "check": "tsc --noEmit && eslint && node --test --test-isolation=none \"tests/**/*.test.ts\"",
    "db:render": "node scripts/db-schema.mjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:push:pg": "node scripts/db-schema.mjs && prisma db push --schema prisma/schema.postgres.prisma",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.ts",
    "db:seed:pg": "node scripts/db-schema.mjs && prisma generate && node prisma/seed.ts",
    "db:seed:demo": "node scripts/db-schema.mjs && prisma generate && node scripts/seed-demo-users.ts",
    "reset-password": "node scripts/reset-password.mjs",
    "regress": "node tools/regress.mjs",
    "interact": "node tools/interact.mjs",
    "shoot": "node tools/shoot.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^12.6.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.23.0",
    "next": "^16.3.8",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.3.8",
    "postcss": "^8",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}
